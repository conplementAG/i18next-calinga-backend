{
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "./dist",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "rootDir": "./src",
    "target": "ES2020",
    "strict": true,
    "types": ["jest", "node"]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": ["node_modules"]
}
